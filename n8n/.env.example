# Copia este archivo a ".env" y ajusta los valores:
#   cp .env.example .env

# Host/puerto/protocolo para acceso local.
N8N_HOST=localhost
N8N_PROTOCOL=http

# Zona horaria (afecta cron, schedules y logs).
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# URL publica para webhooks. Dejala VACIA para uso local normal.
# Cuando uses el tunel para WhatsApp, pega aca la URL que imprime cloudflared,
# por ejemplo:
# WEBHOOK_URL=https://random-words-1234.trycloudflare.com/
WEBHOOK_URL=
